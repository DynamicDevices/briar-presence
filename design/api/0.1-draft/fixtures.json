  "semanticScenarios": [
    {
      "id": "critical-managed-versus-harmless-blocked",
      "inputCases": ["possible-critical-awareness", "harmless-blocked-choice"],
      "context": "Independent synthetic views, not a sequence to merge as one producer.",
      "expected": ["Critical impact is explicitly provisional; no response is invented for the user", "A harmless blocked choice is Needs you, not time-sensitive without delay consequences", "New critical concern has a brief stronger cue; the ordinary question gets a quieter visible indication"]
    },
    {
      "id": "minor-but-time-sensitive",
      "inputCases": ["minor-time-sensitive-no-exact-deadline"],
      "expected": ["Minor severity stays minor", "Explain timing and consequence of delay without inventing an exact deadline", "Brief stronger cue follows the time-sensitive request, not inflated severity"]
    },
    {
      "id": "success-does-not-resolve",
      "inputCases": ["finished-with-open-concern", "acknowledge-seen-concern"],
      "context": "Concern exists in an authorised demo scope and user-view revision matches.",
      "expected": ["Work remains succeeded and concern remains open", "Missing severity is unassessed, not minor", "Acknowledgement preserves a steady visible cue and authorises no action"]
    },
    {
      "id": "omitted-concern",
      "context": "An otherwise valid newer snapshot omits an existing open concern while reporting changed work.",
      "expected": ["Accept valid changes atomically with a retained concern and source-omission warning", "Keep the concern source revision and observation time unchanged", "Repeated omissions do not reannounce"]
    },
    {
      "id": "stale-important-task",
      "context": "One producer lease expires while other work remains current; its last concern was significant.",
      "expected": ["Preserve significant last-known concern with explicit stale observation", "Do not infer healthy idle, failure, resolution or a new request", "Other producers retain independent freshness"]
    },
    {
      "id": "combined-arrivals",
      "context": "Several new qualifying attention items arrive close together while another work item is focused.",
      "expected": ["One brief bounded combined cue, then a steady summary", "Every item remains inspectable with its own severity, timing and freshness", "No focus theft; grouping interval and rate limits remain to be specified"]
    },
    {
      "id": "structurally-valid-but-not-authorised",
      "inputCases": ["focus-work", "acknowledge-seen-concern"],
      "context": "Referenced records belong to another user or expected user-view revision is stale.",
      "expected": ["Reject at the semantic/authority boundary without exposing another user's records", "A schema pass is not authority, an existing record or concurrency proof"]
    }
  ]
}
